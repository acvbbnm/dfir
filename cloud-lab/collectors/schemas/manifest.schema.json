{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EA Evidence Manifest",
  "description": "증거 수집 워크플로 최종 결과 manifest",
  "type": "object",
  "required": ["schema_version", "case_id", "finalized_at", "integrity", "jobs"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^CASE-.+"
    },
    "finalized_at": {
      "type": "string",
      "format": "date-time"
    },
    "integrity": {
      "type": "string",
      "enum": ["PASS", "PARTIAL", "FAIL"]
    },
    "total_objects": {
      "type": "integer",
      "minimum": 0
    },
    "verified_objects": {
      "type": "integer",
      "minimum": 0
    },
    "missing_objects": {
      "type": "integer",
      "minimum": 0
    },
    "total_size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "size_bytes", "sha256", "status"],
        "properties": {
          "key": { "type": "string" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "status": { "type": "string", "enum": ["verified", "failed"] }
        }
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "error"],
        "properties": {
          "key": { "type": "string" },
          "error": { "type": "string" }
        }
      }
    },
    "collection_results": {
      "type": "array",
      "description": "Step Functions 병렬 수집 결과 원본"
    }
  }
}
