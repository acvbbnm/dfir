# EA 커스텀 Suricata 규칙
# 초기에는 alert만. IPS drop 전환은 S3 시나리오에서 수동으로 변경.

# SQL Injection 시도 (URI)
alert http $ALB_CLIENTS any -> $HTTP_SERVERS $HTTP_PORTS (msg:"EA SQLi attempt in URI"; flow:to_server,established; content:"UNION"; nocase; content:"SELECT"; nocase; sid:9000001; rev:1; classtype:web-application-attack;)

# Command injection (/etc/passwd 접근 시도)
alert http $ALB_CLIENTS any -> $HTTP_SERVERS $HTTP_PORTS (msg:"EA cmd injection /etc/passwd"; flow:to_server,established; content:"/etc/passwd"; sid:9000002; rev:1; classtype:web-application-attack;)

# PHP webshell 키워드
alert http $HTTP_SERVERS $HTTP_PORTS -> any any (msg:"EA possible PHP webshell response"; flow:to_client,established; content:"system("; nocase; sid:9000003; rev:1; classtype:trojan-activity;)

# 비정상 User-Agent (일반적인 공격 도구)
alert http $ALB_CLIENTS any -> $HTTP_SERVERS $HTTP_PORTS (msg:"EA suspicious user-agent sqlmap"; flow:to_server,established; content:"sqlmap"; nocase; http_user_agent; sid:9000004; rev:1; classtype:web-application-attack;)

alert http $ALB_CLIENTS any -> $HTTP_SERVERS $HTTP_PORTS (msg:"EA suspicious user-agent nikto"; flow:to_server,established; content:"nikto"; nocase; http_user_agent; sid:9000005; rev:1; classtype:web-application-attack;)

# Login burst per ALB source IP; original-client attribution requires WAF/HTTP/SIEM correlation.
alert http $ALB_CLIENTS any -> $HTTP_SERVERS $HTTP_PORTS (msg:"EA wp-login brute force"; flow:to_server,established; content:"POST"; http_method; content:"/wp-login.php"; http_uri; threshold:type both, track by_src, count 10, seconds 5; sid:9000006; rev:1; classtype:attempted-admin;)
